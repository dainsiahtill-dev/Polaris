    "policy.permission",
    "llm.provider_runtime",
    "orchestration.pm_dispatch",
    "chief_engineer.blueprint",
    "roles.kernel",
    "events.fact_stream",
    "storage.layout",
    "roles.adapters",
    "control_plane.run_ledger",
    "control_plane.verifier_policy",
    "control_plane.verifier_execution",
    "runtime.projection",
    "director.runtime"
  ],
  "owned_paths": [
    "polaris/delivery/http/routers/factory.py",
    "polaris/delivery/cli/factory/**",
    "polaris/cells/factory/pipeline/internal/**",
    "polaris/cells/factory/pipeline/tests/**"
  ],
  "state_owners": [
    "workspace/factory/*",
