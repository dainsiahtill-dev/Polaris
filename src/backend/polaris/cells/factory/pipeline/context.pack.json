  ],
  "test_targets": [
    "polaris/cells/factory/pipeline/tests/test_factory_event_chain.py",
    "polaris/cells/factory/pipeline/tests/test_factory_role_evidence_admission.py",
    "polaris/cells/factory/pipeline/tests/test_factory_role_evidence_authority.py",
    "polaris/cells/factory/pipeline/tests/test_factory_role_evidence_provenance.py",
    "polaris/cells/factory/pipeline/tests/test_factory_role_evidence_run_service.py",
    "polaris/cells/factory/pipeline/tests/test_factory_stage_persistence.py",
    "polaris/cells/factory/pipeline/tests/test_factory_stage_persistence_service.py"
  ]
}
