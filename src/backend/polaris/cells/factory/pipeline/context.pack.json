{
  "cell_id": "factory.pipeline",
  "version": "1.1",
  "summary": "Factory orchestration with strict event-authoritative run persistence and role-evidence provenance",
  "depends_on": [
    "orchestration.workflow_runtime",
    "roles.runtime",
    "runtime.task_runtime",
    "runtime.state_owner",
    "runtime.execution_broker",
    "archive.factory_archive",
    "audit.evidence",
