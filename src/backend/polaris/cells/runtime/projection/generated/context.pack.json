{
  "id": "runtime.projection",
  "title": "Runtime Projection",
  "kind": "projection",
  "purpose": "Build read-only runtime status projections and transport payloads without hidden writes.",
  "summary": "Owns projection-only runtime reads and outbound runtime status payloads for HTTP and WebSocket consumers.",
  "owned_paths": [
    "polaris/cells/runtime/projection/**",
    "polaris/delivery/http/routers/runtime.py",
    "polaris/delivery/ws/runtime_endpoint.py",
    "polaris/delivery/ws/runtime_event_query.py"
  ],
  "public_contracts": {
    "commands": [],
    "queries": [
      "RuntimeProjectionQueryV1",
      "ProjectOutcomeQueryV1",
      "ProjectOutcomeFactoryOwnerQueryV1"
    ],
    "events": [
      "RuntimeProjectedEventV1",
      "RuntimeObserverEventV1"
    ],
    "results": [
      "RuntimeProjectionResultV1",
      "DirectorStatusObservationV1",
      "ProjectOutcomeV1",
      "FactoryChainOwnerObservationV1",
      "ProjectOutcomeFactoryOwnerBindingV1"
    ],
    "errors": [
      "RuntimeProjectionErrorV1",
      "DirectorStatusObservationV1Error",
      "ProjectOutcomeValidationV1Error",
      "ProjectOutcomeOwnerObservationV1Error"
    ]
  },
  "neighbors": [
    "audit.evidence",
    "control_plane.run_ledger",
    "docs.court_workflow",
    "events.fact_stream",
    "llm.evaluation",
    "llm.provider_runtime",
    "orchestration.pm_planning",
    "orchestration.workflow_runtime",
    "qa.audit_verdict",
    "resident.autonomy",
    "runtime.artifact_store",
    "runtime.state_owner",
    "runtime.task_market",
    "runtime.task_runtime",
    "storage.layout",
    "workspace.integrity"
  ],
  "state_owners": [],
  "effects_allowed": [
    "fs.read:runtime/*",
    "fs.read:workspace/history/*",
    "ws.outbound:runtime/*"
  ],
  "invariants": [
    "query paths remain read-only",
    "projection may not create source-of-truth writes",
    "all text reads use explicit UTF-8"
  ],
  "hotspots": [
    "polaris/cells/runtime/projection/internal/runtime_projection_service.py",
    "polaris/cells/runtime/projection/internal/director_status_owner.py",
    "polaris/cells/runtime/projection/internal/project_outcome.py",
    "polaris/cells/runtime/projection/internal/project_outcome_factory_owner.py",
    "polaris/cells/runtime/projection/public/bootstrap.py",
    "polaris/cells/runtime/projection/public/contracts.py",
    "polaris/delivery/http/routers/runtime.py"
  ],
  "test_targets": [
    "tests/test_realtime_single_rail_static_guard.py",
    "tests/test_runtime_projection_observability.py",
    "polaris/cells/runtime/projection/tests/test_project_outcome.py",
    "polaris/cells/runtime/projection/tests/test_factory_chain_owner_binding.py",
    "polaris/cells/runtime/projection/tests/test_director_status_owner_binding.py",
    "polaris/cells/runtime/projection/tests/test_gr1c_dependency_cut.py"
  ],
  "change_guidance": {
    "read_order": [
      "cell.yaml",
      "README.agent.md",
      "generated/context.pack.json",
      "public/contracts.py"
    ],
    "expand_to_neighbors_only_when_needed": true
  }
}
