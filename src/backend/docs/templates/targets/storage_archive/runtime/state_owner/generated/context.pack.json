{
  "template": true,
  "id": "runtime.state_owner",
  "title": "Runtime State Owner",
  "kind": "capability",
  "purpose": "Act as the single writer for runtime task, contract, run, and state files while exposing controlled read queries for projection and archive-oriented cells.",
  "summary": "Target blueprint aligned to the current runtime source-of-truth cells. It isolates runtime writes from archive publication and provides the controlled read surface consumed by archive and projection flows.",
  "owned_paths": [
    "polaris/cells/runtime/state_owner/**"
  ],
  "public_contracts": {
    "commands": [
      "PersistRuntimeTaskStateCommandV1",
      "PersistRuntimeContractCommandV1",
      "PersistRuntimeRunCommandV1"
    ],
    "queries": [
      "GetRuntimeSnapshotQueryV1",
      "GetRuntimeRunQueryV1"
    ],
    "events": [
      "RuntimeStateChangedEventV1",
      "RuntimeStateWrittenEventV1"
    ],
    "results": [
      "RuntimeStateWriteResultV1",
      "RuntimeSnapshotResultV1",
      "RuntimeRunResultV1"
    ],
    "errors": [
      "RuntimeStateOwnerErrorV1"
    ]
  },
  "neighbors": [
    "storage.layout",
    "policy.workspace_guard",
    "audit.evidence",
    "runtime.projection",
    "archive.run_archive",
    "archive.task_snapshot_archive"
  ],
  "state_owners": [
    "runtime_task_state",
    "runtime_contract_state",
    "runtime_run_state",
    "runtime_snapshot_state"
  ],
  "effects_allowed": [
    "fs.read:runtime/*",
    "fs.write:runtime/tasks/*",
    "fs.write:runtime/contracts/*",
    "fs.write:runtime/runs/*",
    "fs.write:runtime/state/*"
  ],
  "invariants": [
    "runtime source-of-truth writes remain single-owner",
    "all runtime text file writes use explicit UTF-8",
    "history publication is delegated to archive cells"
  ],
  "hotspots": [
    "polaris/cells/runtime/state_owner/internal/state.py",
    "polaris/cells/runtime/state_owner/internal/runtime_state_registry.py",
    "polaris/cells/runtime/task_runtime/internal/service.py",
    "polaris/cells/runtime/task_runtime/internal/task_board.py",
    "polaris/cells/runtime/task_market/internal/service.py",
    "polaris/cells/runtime/projection/internal/runtime_projection_service.py"
  ],
  "test_targets": [
    "polaris/tests/cells/runtime/state_owner/internal/test_runtime_state_registry.py",
    "polaris/tests/test_pm_contract_store_kfs.py",
    "polaris/tests/architecture/test_architecture_invariants.py"
  ],
  "change_guidance": {
    "read_order": [
      "cell.yaml",
      "README.agent.md",
      "generated/context.pack.json",
      "public/contracts/*",
      "current runtime compatibility entrypoints"
    ],
    "expand_to_neighbors_only_when_needed": true
  }
}
